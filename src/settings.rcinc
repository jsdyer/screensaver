#include <windows.h>
#include "resource.h"

STRINGTABLE
BEGIN
    IDS_SCENE_NAME SCENE_TITLE
END

IDD_SETTINGS DIALOGEX 0, 0, 182, 64
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Screen saver settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Animation speed", -1, 9, 12, 68, 12
    COMBOBOX IDC_SPEED, 82, 9, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 67, 40, 50, 15
    PUSHBUTTON "Cancel", IDCANCEL, 122, 40, 50, 15
END
